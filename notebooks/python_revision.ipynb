   "source": [
    "# write python functions to add number using args\n",
    "# add_numbers(1, 2, 3) should return 6\n",
    "def add_numbers(*args):\n",
    "    total = 0\n",
    "    for num in args:\n",
    "        total += num\n",
    "    return total\n",
    "\n",
    "add_numbers(1,2,3)   "
   ]
